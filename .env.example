# Database Configuration
DB_HOST=localhost
DB_NAME=orca_iot
DB_USER=your_db_user
DB_PASS=your_secure_password
DB_CHARSET=utf8mb4

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com/orca_backend

# Security
CORS_ALLOWED_ORIGINS=https://yourdomain.com
SESSION_SECURE=true

# Email Configuration (for alarm notifications)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Orca IoT Platform"
MAIL_ENCRYPTION=tls
MAIL_USE_SIMPLE=false

# Device provisioning (api/provision.php)
#
# Private key that signs device grants - the PEM tools/grant_sign.py keygen
# writes. Keep it OUTSIDE public_html. Default: the directory above public_html.
GRANT_PRIVATE_KEY_PATH=/home/your_user/grant_key.pem

# The key the bench tool sends as "Authorization: Bearer <key>". One vendor
# today, so Orca ships with this value built in - it is not a strong secret,
# it keeps the endpoint from answering the open internet. Empty or missing
# means provisioning is switched off and the API says so (503).
PROVISION_KEY=

# Serials are this prefix plus digits, eight characters in all (A -> A0020707).
PROVISION_SERIAL_PREFIX=A

# Shown in the tool and on the admin page. Cosmetic.
PROVISION_VENDOR_NAME=Almas Electronic

# The reserved serials for development and test boards - not devices, not
# counted, and any number of chips may hold the same one at once. Comma
# separated. Leave empty for the built-in ten (A0010707 .. A0100707); the
# list is what makes a row a test row, so change it with care.
PROVISION_TEST_SERIALS=

# Simu licensing (api/simu_request.php, api/simu_poll.php, admin/simu_licenses.php)
#
# Private key that signs Simu licences - a NIST P-256 PEM, a different key
# from the device grants on purpose. Keep it OUTSIDE public_html, beside
# grant_key.pem. Simu-Backend/tools/simu_license.py keygen makes one.
SIMU_LICENSE_KEY_PATH=/home/your_user/simu_license_key.pem

# The key Simu sends as "Authorization: Bearer <key>". It ships inside
# Simu.exe, so it is not a secret - it keeps the request endpoint from
# answering the open internet, nothing more. Empty or missing means Simu
# licensing is switched off and the API says so (503). Must equal
# license_app_key in Simu-Backend/app/config.py.
SIMU_APP_KEY=
